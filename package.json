{
  "name": "skyfront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Skyfront — rekonstruierter, wieder baubarer Quellcode (autarker Single-File-Build). Kein Build-Framework nötig; Skripte nutzen nur die Node-Standardbibliothek. Playwright wird nur für den Boot-Test gebraucht.",
  "scripts": {
    "build": "node build.mjs",
    "pages": "node build.mjs && node pages.mjs",
    "variants": "node build-variants.mjs",
    "all": "node build-all.mjs",
    "schnell": "node schnell.mjs",
    "check": "node check.mjs --ohne=bildtor",
    "torkette": "node check.mjs --streng",
    "wache": "node tools/wache.mjs",
    "proben": "node tools/farbproben.mjs --alle",
    "probenkurz": "node tools/farbproben.mjs --nurmodus --ohnebild",
    "bildtor": "node tools/bildtor.mjs",
    "farbtor": "node tools/farbtor.mjs",
    "farbproben": "node tools/farbproben.mjs",
    "formen": "node tools/formen.mjs",
    "formationen": "node tools/formationen.mjs",
    "version": "node tools/version.mjs",
    "untergrund": "node tools/untergrund.mjs",
    "feuerkraft": "node tools/feuerkraft.mjs",
    "speicher": "node tools/speicher.mjs",
    "rhythmus": "node tools/rhythmus.mjs",
    "schirme": "node tools/schirme.mjs",
    "symbol": "node tools/symbol.mjs",
    "bilder": "node tools/bilder.mjs",
    "package": "node build-all.mjs --zip",
    "package:master": "node build-all.mjs --zip=master",
    "release": "node build-all.mjs --zip --boot",
    "symbolprobe": "node tools/symbol.mjs --probe",
    "nummern": "node tools/nummern.mjs",
    "bildpruefung": "node tools/bildpruefung.mjs",
    "einbau": "node tools/einbau.mjs",
    "zeitachse": "node tools/zeitachse.mjs",
    "bossmuster": "node tools/bossmuster.mjs",
    "steuerung": "node tools/steuerung.mjs",
    "fenstereichen": "node tools/fenstereichen.mjs",
    "bildbogen": "node tools/geschossbogen.mjs",
    "bestellung": "node tools/bestellung.mjs",
    "vorwaermen": "node tools/vorwaermen.mjs",
    "niederlage": "node tools/niederlage.mjs",
    "geschossdichte": "node tools/geschossdichte.mjs",
    "klang": "node tools/klang.mjs",
    "musik": "node tools/musik.mjs",
    "musikeinbau": "node tools/musikeinbau.mjs",
    "musikbacken": "python3 tools/musikbacken.py",
    "musikschau": "sh tools/musikschau.sh",
    "auslieferung": "node tools/auslieferung.mjs",
    "ueberlappung": "node tools/ueberlappung.mjs",
    "kopfzeile": "node tools/kopfzeile.mjs",
    "ruestung": "node tools/ruestung.mjs",
    "messtafel": "node tools/messtafel.mjs",
    "zeichenwerk": "node tools/zeichenwerk.mjs",
    "sektor": "node tools/sektor.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "sharp": "0.35.3"
  }
}
